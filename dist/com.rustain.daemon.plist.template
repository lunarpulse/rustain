<?xml version="1.0" encoding="UTF-8"?>
<!-- Rustain daemon — launchd LaunchAgent template (Story 12.1b).

     Generated by `rustain daemon install`. This file is the checked-in reference the
     generator reads via include_str!, so the two can never drift.

     LOAD-BEARING (AC-12-1b-9): ProgramArguments uses `daemon start --foreground` so
     launchd owns the daemon process DIRECTLY. A bare `daemon start` detaches a child
     and the launcher exits immediately — launchd would restart-loop the launcher,
     never supervising the real daemon.

     KeepAlive { SuccessfulExit = false } (NFR50): relaunch ONLY on unclean exit, so a
     clean `stop` is honored. Placeholders ({...}) are filled by render_launchd_plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{exe}</string>
        <string>--profile</string>
        <string>{profile}</string>
        <string>daemon</string>
        <string>start</string>
        <string>--foreground</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{workspace}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>{log_path}</string>
    <key>StandardErrorPath</key>
    <string>{log_path}</string>
{env_block}</dict>
</plist>
