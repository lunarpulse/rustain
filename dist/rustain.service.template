# Rustain daemon — systemd unit template (Story 12.1b).
#
# Generated by `rustain daemon install`. This file is the checked-in reference the
# generator reads via include_str!, so the two can never drift (AC-12-1b-9 review
# checklist: every Layer-3 token has a Layer-1 content assertion).
#
# LOAD-BEARING (AC-12-1b-9): ExecStart uses `daemon start --foreground` so systemd
# owns the daemon process DIRECTLY. A bare `daemon start` re-execs + setsid-detaches
# a child and the launcher exits immediately — systemd would see the service exit and
# restart-loop the launcher, never supervising the real daemon.
#
# Placeholders ({...}) are substituted by service::render_systemd_unit.
[Unit]
Description=Rustain daemon ({workspace})
After=network.target
# Crash-loop guard (AC-12-1b-1): give up if it fails StartLimitBurst times within
# StartLimitIntervalSec, so a daemon that crashes immediately on boot does not spin.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart={exe} --profile {profile} daemon start --foreground
WorkingDirectory={workspace}
# NFR50: restart on non-zero exit / signal-kill (crash), NOT on a clean `stop`.
Restart=on-failure
RestartSec=2
{user_directive}{env_block}
[Install]
WantedBy=default.target
